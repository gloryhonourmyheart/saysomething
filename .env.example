# 复制成 .env 后填上真 key；.env 不要提交、不要发给队友、不要投屏
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_TOKENS=320

# 小抄改写层（置 SAY_COPY_MODEL=0 只走 L1 规则，断网也能用）
SAY_COPY_MODEL=1
SAY_COPY_TEMPERATURE=0.7
SAY_COPY_MAX_CHARS=52
SAY_COPY_MAX_TOKENS=600
